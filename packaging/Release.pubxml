<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GameLingoReleaseRuntimeVersion>8.0.31</GameLingoReleaseRuntimeVersion>
  </PropertyGroup>
  <Target Name="PinReleaseRuntimePacks" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <!-- Do not set the global RuntimeFrameworkVersion: it also overrides Windows SDK reference packs. -->
      <FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App;Microsoft.WindowsDesktop.App.WPF;Microsoft.AspNetCore.App" RuntimeFrameworkVersion="$(GameLingoReleaseRuntimeVersion)" />
      <!-- The SDK resolves WPF's shared runtime pack from the parent WindowsDesktop known reference. -->
      <KnownFrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App;Microsoft.WindowsDesktop.App.WPF;Microsoft.WindowsDesktop.App.WindowsForms;Microsoft.AspNetCore.App"
                               Condition="'%(TargetFramework)' == 'net8.0'"
                               LatestRuntimeFrameworkVersion="$(GameLingoReleaseRuntimeVersion)" />
    </ItemGroup>
  </Target>
  <Target Name="ExcludeUnusedVideoTransport" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <!-- OCR uses OpenCvSharpExtern; the optional FFmpeg video transport is not part of V1. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio_ffmpeg'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'createdump.exe'" />
    </ItemGroup>
  </Target>
</Project>
