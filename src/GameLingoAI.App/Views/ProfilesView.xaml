<UserControl x:Class="GameLingoAI.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel KeyboardNavigation.TabNavigation="Continue">
    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Game profiles" />
    <TextBlock Margin="0,6,0,8" TextWrapping="Wrap"
               Text="Profiles contain settings only. Importing, loading or matching a window never starts capture." />
    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
              DisplayMemberPath="Name" AutomationProperties.Name="Saved game profile" />
    <WrapPanel Margin="0,8,0,8">
      <Button Content="_Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,6" />
      <Button Content="_Load selected" Command="{Binding LoadCommand}" Margin="0,0,6,6" />
      <Button Content="_New profile" Command="{Binding NewCommand}" Margin="0,0,6,6" />
      <Button Content="_Save profile" Command="{Binding SaveCommand}" Margin="0,0,6,6" />
      <Button Content="_Duplicate draft" Command="{Binding DuplicateCommand}" Margin="0,0,6,6" />
    </WrapPanel>
    <TextBlock Text="{Binding HasUnsavedChanges, StringFormat=Unsaved draft: {0}}" />
    <CheckBox Content="Confirm discarding the current draft for the next load/new/import/duplicate/delete"
              IsChecked="{Binding DiscardConfirmed}" Margin="0,6,0,6" />
    <TextBlock TextWrapping="Wrap" Text="Expand a settings group to edit fields. Numeric values use a decimal point. Region coordinates are fractions from 0 to 1; sort order controls processing order. Save validates ranges before changing saved data." />
    <ItemsControl ItemsSource="{Binding Form.Groups}" IsEnabled="{Binding CanEdit}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Expander Header="{Binding Name}" Margin="0,6,0,0">
            <ItemsControl ItemsSource="{Binding Fields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="8,4,0,4">
                    <Label Content="{Binding Label}" Target="{Binding ElementName=FieldInput}" />
                    <TextBox x:Name="FieldInput" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MaxLength="512"
                             AutomationProperties.Name="{Binding Label}">
                      <TextBox.Style>
                        <Style TargetType="TextBox"><Style.Triggers>
                          <DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers></Style>
                      </TextBox.Style>
                    </TextBox>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding BooleanValue}" AutomationProperties.Name="{Binding Label}">
                      <CheckBox.Style>
                        <Style TargetType="CheckBox"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                          <DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers></Style>
                      </CheckBox.Style>
                    </CheckBox>
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Margin="0,8,0,4" Text="Apply an OCR preprocessing preset to the draft:" />
    <WrapPanel IsEnabled="{Binding CanEdit}">
      <Button Content="Plain subtitle" Command="{Binding PlainPresetCommand}" Margin="0,0,6,6" />
      <Button Content="Outlined subtitle" Command="{Binding OutlinedPresetCommand}" Margin="0,0,6,6" />
      <Button Content="No preprocessing" Command="{Binding NoPreprocessingCommand}" Margin="0,0,6,6" />
    </WrapPanel>
    <WrapPanel Margin="0,8,0,8" IsEnabled="{Binding CanEdit}">
      <Button Content="Add region" Command="{Binding AddRegionCommand}" Margin="0,0,6,0" />
      <ComboBox ItemsSource="{Binding Form.RegionNumbers}" SelectedItem="{Binding SelectedRegionNumber}" Width="65"
                AutomationProperties.Name="Region number to remove" Margin="0,0,6,0" />
      <Button Content="Remove selected region" Command="{Binding RemoveRegionCommand}" />
    </WrapPanel>
    <Expander Header="Advanced JSON editor (optional)">
    <StackPanel>
    <TextBlock TextWrapping="Wrap" Text="Editing JSON temporarily replaces the form. Use Reload form after validating your edits. Identity is protected; use Duplicate instead. No credentials or private file paths." />
    <TextBox Text="{Binding DraftJson, UpdateSourceTrigger=PropertyChanged}" Height="300" MaxLength="131072"
             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             FontFamily="Consolas" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Profile settings JSON draft" />
    <Button Content="Reload form from JSON" Command="{Binding LoadFormCommand}" HorizontalAlignment="Left" Margin="0,6,0,6" />
    </StackPanel>
    </Expander>
    <Label Content="Local credential _reference (not the API key)" Target="{Binding ElementName=CredentialReference}" />
    <TextBox x:Name="CredentialReference" Text="{Binding SecretReference, UpdateSourceTrigger=PropertyChanged}"
             MaxLength="128" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Local credential lookup reference" />
    <TextBlock TextWrapping="Wrap" Margin="0,6,0,6" Text="Export excludes credential references. Import creates an unsaved new identity and drops unknown private fields; only bounded numeric/boolean x-* extensions survive." />
    <WrapPanel>
      <Button Content="_Export draft" Command="{Binding ExportCommand}" Margin="0,0,6,6" />
      <Button Content="_Import as new draft" Command="{Binding ImportCommand}" Margin="0,0,6,6" />
    </WrapPanel>
    <TextBox Text="{Binding TransferJson, UpdateSourceTrigger=PropertyChanged}" Height="150" MaxLength="131072"
             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             AutomationProperties.Name="Portable profile import export JSON" />
    <TextBlock Margin="0,8,0,4" TextWrapping="Wrap"
               Text="Delete removes the selected saved profile, its regions and scoped glossary. Global glossary/cache remain; history is retained without the profile link." />
    <CheckBox Content="Confirm deleting the selected saved profile and its scoped data"
              IsChecked="{Binding DeleteConfirmed}" />
    <Button Content="Delete selected profile" Command="{Binding DeleteCommand}" HorizontalAlignment="Left" Margin="0,6,0,6" />
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</UserControl>
