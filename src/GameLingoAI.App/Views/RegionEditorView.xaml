<UserControl x:Class="GameLingoAI.App.Views.RegionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             MinWidth="420">
  <StackPanel>
    <TextBlock Margin="0,18,0,8"
               FontWeight="SemiBold"
               Text="{StaticResource RegionEditorLabel}" />
    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
      <Button Margin="0,0,8,0"
              Command="{Binding RegionEditor.StartPreviewCommand}"
              Content="{StaticResource StartPreviewLabel}" />
      <Button Command="{Binding RegionEditor.StopPreviewCommand}"
              Content="{StaticResource StopPreviewLabel}" />
    </StackPanel>

    <Border x:Name="PreviewSurface"
            Height="315"
            Background="Black"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            BorderThickness="1"
            ClipToBounds="True"
            SizeChanged="PreviewSurface_SizeChanged">
      <Grid>
        <Image Source="{Binding RegionEditor.PreviewImage}" Stretch="Uniform" />
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="White"
                   Text="{StaticResource PreviewPlaceholderMessage}"
                   TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding RegionEditor.HasPreviewImage}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding RegionEditor.Regions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Canvas.Left" Value="{Binding PreviewX}" />
              <Setter Property="Canvas.Top" Value="{Binding PreviewY}" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}">
                <primitives:Thumb Background="#220078D4"
                                  BorderBrush="#FF00B7FF"
                                  BorderThickness="2"
                                  Cursor="SizeAll"
                                  DragDelta="MoveThumb_DragDelta"
                                  GotKeyboardFocus="RegionThumb_GotKeyboardFocus"
                                  AutomationProperties.Name="Move capture region">
                  <primitives:Thumb.InputBindings>
                    <KeyBinding Key="Left"
                                Command="{Binding DataContext.RegionEditor.NudgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="Left" />
                    <KeyBinding Key="Right"
                                Command="{Binding DataContext.RegionEditor.NudgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="Right" />
                    <KeyBinding Key="Up"
                                Command="{Binding DataContext.RegionEditor.NudgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="Up" />
                    <KeyBinding Key="Down"
                                Command="{Binding DataContext.RegionEditor.NudgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="Down" />
                    <KeyBinding Key="Left" Modifiers="Shift"
                                Command="{Binding DataContext.RegionEditor.NudgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="ResizeLeft" />
                    <KeyBinding Key="Right" Modifiers="Shift"
                                Command="{Binding DataContext.RegionEditor.NudgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="ResizeRight" />
                    <KeyBinding Key="Up" Modifiers="Shift"
                                Command="{Binding DataContext.RegionEditor.NudgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="ResizeUp" />
                    <KeyBinding Key="Down" Modifiers="Shift"
                                Command="{Binding DataContext.RegionEditor.NudgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="ResizeDown" />
                  </primitives:Thumb.InputBindings>
                </primitives:Thumb>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Width="16"
                        Height="16"
                        Background="#FF00B7FF"
                        IsHitTestVisible="False" />
                <primitives:Thumb HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Width="22"
                                  Height="22"
                                  Background="Transparent"
                                  Cursor="SizeNWSE"
                                  DragDelta="ResizeThumb_DragDelta"
                                  GotKeyboardFocus="RegionThumb_GotKeyboardFocus"
                                  AutomationProperties.Name="Resize capture region" />
                <TextBlock Margin="5"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Background="#B0000000"
                           Foreground="White"
                           Text="{Binding Name}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <TextBlock Margin="0,6,0,10"
               Text="{StaticResource RegionKeyboardHelp}"
               TextWrapping="Wrap" />
    <ListBox Height="110"
             ItemsSource="{Binding RegionEditor.Regions}"
             SelectedItem="{Binding RegionEditor.SelectedRegion, Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{Binding SortOrder}" />
            <TextBox Grid.Column="1"
                     MinWidth="180"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel Margin="0,8,0,0">
      <Button Margin="0,0,6,6" Command="{Binding RegionEditor.AddCommand}" Content="{StaticResource AddRegionLabel}" />
      <Button Margin="0,0,6,6" Command="{Binding RegionEditor.DeleteCommand}" Content="{StaticResource DeleteRegionLabel}" />
      <Button Margin="0,0,6,6" Command="{Binding RegionEditor.MoveUpCommand}" Content="{StaticResource MoveRegionUpLabel}" />
      <Button Margin="0,0,6,6" Command="{Binding RegionEditor.MoveDownCommand}" Content="{StaticResource MoveRegionDownLabel}" />
      <Button Margin="0,0,6,6" Command="{Binding RegionEditor.UndoCommand}" Content="{StaticResource UndoRegionLabel}" />
      <Button Margin="0,0,6,6" Command="{Binding RegionEditor.ResetCommand}" Content="{StaticResource ResetRegionLabel}" />
      <Button Margin="0,0,6,6" Command="{Binding RegionEditor.LoadCommand}" Content="{StaticResource LoadRegionDraftLabel}" />
      <Button Margin="0,0,6,6" Command="{Binding RegionEditor.SaveCommand}" Content="{StaticResource SaveRegionDraftLabel}" />
    </WrapPanel>
    <TextBlock Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
               Text="{Binding RegionEditor.ValidationMessage}"
               TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
