{
  "schemaVersion": 4,
  "hotkeys": {
    "enabled": false,
    "bindings": []
  },
  "capture": {
    "framesPerSecond": 8,
    "queueCapacity": 2
  },
  "ocr": {
    "languageModel": "en",
    "minimumConfidence": 0.65,
    "preprocessing": {
      "preset": "plainSubtitle",
      "grayscale": true,
      "contrast": 1.15,
      "threshold": null,
      "invert": false,
      "sharpen": false,
      "scale": 1.5,
      "paddingPixels": 4,
      "paddingValue": 0,
      "maximumOutputWidth": 4096,
      "maximumOutputHeight": 4096,
      "maximumOutputPixels": 16777216,
      "enableDiagnosticImages": false
    }
  },
  "stabilization": {
    "requiredObservations": 2,
    "observationWindowMilliseconds": 600,
    "minimumAverageConfidence": 0.65,
    "similarityThreshold": 0.88,
    "spatialOverlapThreshold": 0.2,
    "immediateChangeConfidence": 0.97,
    "disappearanceObservations": 2,
    "maximumCandidates": 8,
    "maximumSpansPerObservation": 128
  },
  "languages": {
    "source": "auto",
    "target": "en"
  },
  "providers": [
    {
      "id": "local-ollama",
      "kind": "ollama",
      "baseUri": "http://127.0.0.1:11434/",
      "model": "replace-with-installed-model",
      "secretReference": null,
      "timeoutSeconds": 30
    }
  ],
  "cache": {
    "maximumRows": 100000,
    "maximumMegabytes": 500,
    "maximumAgeDays": 30,
    "pruneBatchSize": 64,
    "maximumInFlightRequests": 32,
    "maximumWaitersPerKey": 64
  },
  "overlay": {
    "fontFamily": "Segoe UI",
    "fontSize": 30,
    "bold": true,
    "foreground": "#FFFFFF",
    "outlineColor": "#000000",
    "outlineThickness": 1.5,
    "alignment": "center",
    "anchor": "bottom",
    "maximumWidthRatio": 0.9,
    "horizontalOffsetDips": 0,
    "verticalOffsetDips": -24,
    "maximumCharacters": 1000,
    "maximumLines": 3,
    "backgroundOpacity": 0.55
  },
  "logging": {
    "retainedFileCount": 7,
    "includeRecognizedText": false
  },
  "privacy": {
    "remoteTextProcessingConsent": false,
    "historyEnabled": false,
    "diagnosticScreenshotsEnabled": false
  }
}
