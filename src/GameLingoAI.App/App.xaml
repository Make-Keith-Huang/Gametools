<Application x:Class="GameLingoAI.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnLastWindowClose">
  <Application.Resources>
    <sys:String x:Key="AppTitle">GameLingoAI</sys:String>
    <sys:String x:Key="AppSubtitle">Private, user-controlled game subtitle translation</sys:String>
    <sys:String x:Key="HomeSessionLabel">_Home / Session</sys:String>
    <sys:String x:Key="WindowRegionLabel">_Window / Region</sys:String>
    <sys:String x:Key="ProviderLabel">_Provider</sys:String>
    <sys:String x:Key="ProfilesSettingsLabel">Pro_files / Settings</sys:String>
    <sys:String x:Key="DiagnosticsLabel">_Diagnostics</sys:String>
    <sys:String x:Key="AboutLabel">_About</sys:String>
    <sys:String x:Key="HomeTitle">Home and session</sys:String>
    <sys:String x:Key="HomeDescription">No capture session is configured. Later tasks add explicit window selection and session controls.</sys:String>
    <sys:String x:Key="WindowTitle">Window and capture regions</sys:String>
    <sys:String x:Key="WindowDescription">Choose a supported window and define normalized subtitle regions.</sys:String>
    <sys:String x:Key="ProviderTitle">Translation provider</sys:String>
    <sys:String x:Key="ProviderDescription">Configure local or remote text translation after privacy consent.</sys:String>
    <sys:String x:Key="ProfilesTitle">Profiles and settings</sys:String>
    <sys:String x:Key="ProfilesDescription">Manage portable, non-secret game profiles and safe defaults.</sys:String>
    <sys:String x:Key="DiagnosticsTitle">Diagnostics</sys:String>
    <sys:String x:Key="DiagnosticsDescription">Review actionable status and privacy-safe diagnostic information.</sys:String>
    <sys:String x:Key="AboutTitle">About GameLingoAI</sys:String>
    <sys:String x:Key="AboutDescription">V1 keeps pixels local and never uses audio, injection, hooks, or game-file modification.</sys:String>
    <sys:String x:Key="SessionStateLabel">Session state:</sys:String>
    <sys:String x:Key="ValidationLabel">Configuration issues</sys:String>
    <sys:String x:Key="RefreshWindowsLabel">_Refresh windows</sys:String>
    <sys:String x:Key="ConfirmWindowLabel">_Confirm selection</sys:String>
    <sys:String x:Key="SelectWindowLabel">Select a capture target</sys:String>
    <sys:String x:Key="SelectionRequiredMessage">Select a window to continue.</sys:String>
    <sys:String x:Key="ConfirmationRequiredMessage">Confirm this window before capture can start.</sys:String>
    <sys:String x:Key="SelectionReadyMessage">Window selection confirmed.</sys:String>
    <sys:String x:Key="TargetUnavailableMessage">The selected window closed or changed identity. Refresh and select it again.</sys:String>
    <sys:String x:Key="RegionEditorLabel">Local preview and subtitle regions</sys:String>
    <sys:String x:Key="StartPreviewLabel">Start local _preview</sys:String>
    <sys:String x:Key="StopPreviewLabel">S_top preview</sys:String>
    <sys:String x:Key="PreviewPlaceholderMessage">Confirm a window, then start the local preview. Pixels remain in memory on this device.</sys:String>
    <sys:String x:Key="RegionKeyboardHelp">Focus a region handle and use arrow keys to move by one preview DIP; hold Shift and use arrows to resize.</sys:String>
    <sys:String x:Key="AddRegionLabel">_Add region</sys:String>
    <sys:String x:Key="DeleteRegionLabel">_Delete region</sys:String>
    <sys:String x:Key="MoveRegionUpLabel">Move _up</sys:String>
    <sys:String x:Key="MoveRegionDownLabel">Move dow_n</sys:String>
    <sys:String x:Key="UndoRegionLabel">_Undo</sys:String>
    <sys:String x:Key="ResetRegionLabel">_Reset</sys:String>
    <sys:String x:Key="LoadRegionDraftLabel">_Load draft</sys:String>
    <sys:String x:Key="SaveRegionDraftLabel">_Save draft</sys:String>
    <sys:String x:Key="StartupErrorTitle">GameLingoAI could not start</sys:String>
    <sys:String x:Key="StartupErrorMessage">The application could not initialize. Verify the .NET desktop runtime and configuration, then restart.</sys:String>

    <Style TargetType="Window">
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="NavigationButtonStyle" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
    </Style>
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Application.Resources>
</Application>
